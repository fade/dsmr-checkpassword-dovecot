#!/bin/bash
# dsmr-smtpauth — manage SMTP-AUTH users in /etc/dovecot/system-passwd.
#
# Subcommands:
#   add <user>     Add a new SMTP-AUTH entry (prompts for password).
#   del <user>     Remove an entry.
#   list           List usernames currently authorized for SMTP-AUTH.
#   passwd <user>  Change the password for an existing entry.
#   test <user>    Authenticate via the checkpassword-dovecot bridge to
#                  confirm dovecot accepts the credential end-to-end.
#
# Entries for Unix users carry uid/gid/home/shell pulled from getent passwd so
# the file also serves dovecot's userdb chain for IMAP/Maildir access. Entries
# for non-Unix users (relay-only credentials) carry only the password hash —
# those users can authenticate for SMTP AUTH but have no Maildir to access.
#
# On add/passwd for a Unix user, RELAY_AUTH.txt is written to the user's home
# directory holding the cleartext password and ready-to-use IMAP/SMTP client
# settings (with step-by-step Thunderbird and Apple Mail instructions). It is
# mode 0600, owned by the user, refreshed on every password change, and removed
# by del so a revoked credential leaves nothing behind.
#
# Edits are made under flock(2); a tmp file is written, chowned, and renamed
# atomically so a partial write cannot leave the file in a broken state.

set -euo pipefail

AUTHFILE=/etc/dovecot/system-passwd
LOCKFILE=/etc/dovecot/.system-passwd.lock
BRIDGE=/var/qmail/bin/checkpassword-dovecot
SCHEME=SHA512-CRYPT
QCTL=/var/qmail/control
RELAY_AUTH_NAME=RELAY_AUTH.txt
RELAY_AUTH_MARKER="# dsmr-smtpauth: SMTP relay credential"

die()        { echo "dsmr-smtpauth: error: $*" >&2; exit 1; }
need_root()  { [ "$(id -u)" -eq 0 ] || die "must run as root"; }

valid_user() {
    # Permit Unix-style names plus full-email forms.  Conservative on purpose:
    # the value lands in field 1 of a colon-separated record, so anything
    # exotic risks corrupting the file or the FORCEAUTHMAILFROM comparison.
    [[ "$1" =~ ^[A-Za-z0-9._@-]+$ ]] \
        || die "invalid username '$1'; allowed chars: A-Z a-z 0-9 . _ @ -"
}

ensure_authfile() {
    if [ ! -e "$AUTHFILE" ]; then
        install -m 0640 -o root -g dovecot /dev/null "$AUTHFILE"
    fi
    if [ ! -e "$LOCKFILE" ]; then
        install -m 0640 -o root -g dovecot /dev/null "$LOCKFILE"
    fi
}

# Read a password without echo, with confirmation prompt; emit on stdout.
# All UI goes to stderr so callers can capture the password cleanly.
read_password() {
    local prompt="$1" pw1 pw2
    read -srp "$prompt: " pw1; echo >&2
    read -srp "Confirm: "  pw2; echo >&2
    [ -n "$pw1" ]       || die "empty password"
    [ "$pw1" = "$pw2" ] || die "passwords don't match"
    printf '%s' "$pw1"
}

# Hash a password via doveadm pw, feeding the secret on stdin (never argv,
# so it can't be observed by another process via /proc/<pid>/cmdline).
hash_password() {
    local pw="$1"
    printf '%s\n%s\n' "$pw" "$pw" | doveadm pw -s "$SCHEME" 2>/dev/null
}

# Compose a passwd(5)-style entry line for the given user and hash.
# For Unix users, fields 3-7 are filled from getent passwd so dovecot's
# userdb chain can return uid/gid/home — required for IMAP because
# 99-vpopmail-mail.conf sets mail_path=~/Maildir, which only expands when
# the userdb supplies a home directory. For non-Unix users (relay-only
# credentials) the trailing fields are left empty: SMTP AUTH still works,
# IMAP/Maildir is intentionally inaccessible.
compose_entry() {
    local user="$1" hash="$2"
    local pw_entry uid gid home shell
    if pw_entry=$(getent passwd "$user" 2>/dev/null) && [ -n "$pw_entry" ]; then
        uid=$(echo "$pw_entry" | cut -d: -f3)
        gid=$(echo "$pw_entry" | cut -d: -f4)
        home=$(echo "$pw_entry" | cut -d: -f6)
        shell=$(echo "$pw_entry" | cut -d: -f7)
        printf '%s:%s:%s:%s::%s:%s\n' "$user" "$hash" "$uid" "$gid" "$home" "$shell"
    else
        printf '%s:%s::::\n' "$user" "$hash"
    fi
}

# Replace AUTHFILE atomically with content piped in on stdin.
# Caller is responsible for holding the lock.
write_authfile() {
    local tmp
    tmp=$(mktemp -p "$(dirname "$AUTHFILE")" .system-passwd.tmp.XXXXXX)
    cat > "$tmp"
    chown root:dovecot "$tmp"
    chmod 0640 "$tmp"
    mv -f "$tmp" "$AUTHFILE"
}

# The FQDN clients connect to for IMAP and submission. control/me is the qmail
# host identity; fall back to the system FQDN if it is missing.
derive_mailhost() {
    local h=""
    [ -s "$QCTL/me" ] && h=$(head -1 "$QCTL/me" | tr -d '[:space:]')
    [ -n "$h" ] || h=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo localhost)
    printf '%s' "$h"
}

# The mail domain in a system user's address. On a hybrid host that is the first
# localfirstdomain (system user 'alice' receives as alice@<that domain>); on a
# plain system host it is control/me. A leading-dot wildcard entry is stripped.
derive_maildomain() {
    local d=""
    if [ -s "$QCTL/localfirstdomains" ]; then
        d=$(grep -vE '^[[:space:]]*(#|$)' "$QCTL/localfirstdomains" \
              | head -1 | sed 's/^\.//' | tr -d '[:space:]')
    fi
    [ -n "$d" ] || { [ -s "$QCTL/me" ] && d=$(head -1 "$QCTL/me" | tr -d '[:space:]'); }
    printf '%s' "$d"
}

# Write <home>/RELAY_AUTH.txt for a Unix user: the cleartext password plus
# client-config instructions. Best-effort — a failure here warns but never fails
# the password change that already succeeded. No-op for a non-Unix (relay-only)
# credential, which has no home directory.
write_relay_auth() {
    local user="$1" pw="$2"
    local pw_entry uid gid home host domain addr file tmp date
    pw_entry=$(getent passwd "$user" 2>/dev/null) || return 0
    [ -n "$pw_entry" ] || return 0
    uid=$(echo "$pw_entry" | cut -d: -f3)
    gid=$(echo "$pw_entry" | cut -d: -f4)
    home=$(echo "$pw_entry" | cut -d: -f6)
    if [ -z "$home" ] || [ ! -d "$home" ]; then
        echo "note: no home directory for '$user'; skipped $RELAY_AUTH_NAME" >&2
        return 0
    fi

    host=$(derive_mailhost)
    domain=$(derive_maildomain)
    addr="$user${domain:+@$domain}"
    file="$home/$RELAY_AUTH_NAME"
    date=$(date +%Y-%m-%d)

    tmp=$(mktemp -p "$home" .relay-auth.XXXXXX 2>/dev/null) || {
        echo "warning: could not create $file (home not writable?)" >&2
        return 0
    }
    cat > "$tmp" <<EOF
$RELAY_AUTH_MARKER — KEEP PRIVATE
This is a mail-only password, separate from your Unix login password. It is
rewritten every time your mail password is set with dsmr-smtpauth.

  Email address:  $addr
  Password:       $pw

Server settings (use the SAME address and password for both):

  Sending (SMTP submission)   server $host   port 587   security STARTTLS
  Reading (IMAP)              server $host   port 993   security SSL/TLS

Authentication is required for sending; the From address must be the address
above. If the server's certificate is self-signed, the client warns once —
trust/accept it to continue.

------------------------------------------------------------------------
Thunderbird
  1. Account Settings -> Account Actions -> Add Mail Account.
  2. Your name: anything.  Email address: $addr.  Password: (above).
  3. Click "Configure manually" and set both servers:
       Incoming   IMAP   Server $host   Port 993   SSL/TLS    Normal password
       Outgoing   SMTP   Server $host   Port 587   STARTTLS   Normal password
       Username (incoming AND outgoing): $addr
  4. Re-test, then Done.  Accept the certificate if prompted.

Apple Mail (macOS)
  1. Mail -> Settings -> Accounts -> "+" -> Other Mail Account.
  2. Name: anything.  Email: $addr.  Password: (above).  Sign In.
  3. Auto-detect fails; continue to the manual screen and set:
       Account type:           IMAP
       Incoming mail server:   $host
       Outgoing mail server:   $host
       User name:              $addr
  4. Open Accounts -> (this account) -> Server Settings and turn OFF
     "Automatically manage connection settings", then set:
       Incoming (IMAP):  Port 993, Use TLS/SSL ON, Authentication Password
       Outgoing (SMTP):  Port 587, Use TLS/SSL ON, Authentication Password
  5. Save.  Trust the certificate if prompted.
------------------------------------------------------------------------
Generated $date by dsmr-smtpauth on $host.
EOF
    chown "$uid:$gid" "$tmp" 2>/dev/null || true
    chmod 0600 "$tmp"        2>/dev/null || true
    if mv -f "$tmp" "$file" 2>/dev/null; then
        echo "Wrote $file (mode 0600, owner $user)"
    else
        rm -f "$tmp" 2>/dev/null || true
        echo "warning: could not write $file" >&2
    fi
}

# Remove a RELAY_AUTH.txt that this tool generated (identified by its marker
# line), so revoking a credential with del leaves no stale password behind.
# Best-effort and conservative: a file without our marker is left untouched.
remove_relay_auth() {
    local user="$1" home file
    home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6) || return 0
    [ -n "$home" ] || return 0
    file="$home/$RELAY_AUTH_NAME"
    [ -f "$file" ] || return 0
    if head -1 "$file" 2>/dev/null | grep -q "^${RELAY_AUTH_MARKER}"; then
        rm -f "$file" && echo "Removed $file"
    else
        echo "note: $file not generated by dsmr-smtpauth; left in place" >&2
    fi
}

# Run the bridge against dovecot with the given credentials.  Returns the
# bridge's exit code unchanged: 0 = OK, 1 = FAIL, anything else = transient.
run_bridge() {
    local user="$1" pw="$2" ts
    [ -x "$BRIDGE" ] || die "$BRIDGE not installed"
    ts=$(date +%s)

    # The bridge needs the vpopmail UID to read /var/run/dovecot/auth-client-smtp.
    if [ "$(id -un)" = "vpopmail" ]; then
        "$BRIDGE" /bin/true 3< <(printf '%s\0%s\0%s\0' "$user" "$pw" "$ts")
    elif [ "$(id -u)" -eq 0 ]; then
        runuser -u vpopmail -- bash -c \
            '"$0" /bin/true 3< <(printf "%s\0%s\0%s\0" "$1" "$2" "$3")' \
            "$BRIDGE" "$user" "$pw" "$ts"
    else
        die "must run as root or vpopmail to call the bridge"
    fi
}

cmd_list() {
    ensure_authfile
    awk -F: '/^[^#:]/ { print $1 }' "$AUTHFILE"
}

cmd_add() {
    local user="${1:-}"
    [ -n "$user" ] || die "usage: dsmr-smtpauth add <user>"
    valid_user "$user"
    need_root
    ensure_authfile

    if grep -q "^${user}:" "$AUTHFILE" 2>/dev/null; then
        die "user '$user' already exists; use 'passwd' to change password"
    fi
    if ! id "$user" >/dev/null 2>&1; then
        echo "note: '$user' is not a Unix user; entry will authorize SMTP AUTH only" >&2
        echo "      (no uid/gid/home — dovecot IMAP/Maildir won't work for this user)" >&2
    fi

    local pw hash
    pw=$(read_password "Password for $user")
    hash=$(hash_password "$pw")
    [ -n "$hash" ] || die "doveadm pw returned no hash"

    (
        flock -x 9
        { cat "$AUTHFILE"; compose_entry "$user" "$hash"; } | write_authfile
    ) 9>"$LOCKFILE"
    echo "Added $user to $AUTHFILE"

    # Self-verify: confirm dovecot agrees the credential is valid.
    local rc=0
    run_bridge "$user" "$pw" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0)  echo "Verified: dovecot accepts the credential." ;;
        1)  echo "WARNING: dovecot rejected the credential we just added." \
                 "Reload dovecot and retry: 'systemctl reload dovecot'." >&2 ;;
        *)  echo "WARNING: bridge returned exit $rc; check dovecot status." >&2 ;;
    esac

    write_relay_auth "$user" "$pw"
}

cmd_del() {
    local user="${1:-}"
    [ -n "$user" ] || die "usage: dsmr-smtpauth del <user>"
    valid_user "$user"
    need_root
    ensure_authfile
    if ! grep -q "^${user}:" "$AUTHFILE" 2>/dev/null; then
        die "user '$user' not in $AUTHFILE"
    fi
    (
        flock -x 9
        awk -v u="$user" -F: '$1 != u' "$AUTHFILE" | write_authfile
    ) 9>"$LOCKFILE"
    echo "Removed $user from $AUTHFILE"

    remove_relay_auth "$user"
}

cmd_passwd() {
    local user="${1:-}"
    [ -n "$user" ] || die "usage: dsmr-smtpauth passwd <user>"
    valid_user "$user"
    need_root
    ensure_authfile
    if ! grep -q "^${user}:" "$AUTHFILE" 2>/dev/null; then
        die "user '$user' not in $AUTHFILE"
    fi
    local pw hash new_line
    pw=$(read_password "New password for $user")
    hash=$(hash_password "$pw")
    [ -n "$hash" ] || die "doveadm pw returned no hash"
    new_line=$(compose_entry "$user" "$hash")

    (
        flock -x 9
        awk -v u="$user" -v new="$new_line" -F: \
            '$1 == u { print new; next } { print }' \
            "$AUTHFILE" | write_authfile
    ) 9>"$LOCKFILE"
    echo "Updated password for $user"

    write_relay_auth "$user" "$pw"
}

cmd_test() {
    local user="${1:-}"
    [ -n "$user" ] || die "usage: dsmr-smtpauth test <user>"
    valid_user "$user"
    local pw rc=0
    read -srp "Password to test for $user: " pw; echo >&2
    [ -n "$pw" ] || die "empty password"

    run_bridge "$user" "$pw" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0)  echo "OK — dovecot accepted credentials for '$user'"; return 0 ;;
        1)  echo "FAIL — dovecot rejected credentials for '$user'"; return 1 ;;
        *)  echo "ERROR — bridge exited $rc (transient/internal error)"; return "$rc" ;;
    esac
}

usage() {
    cat <<EOF
Usage: dsmr-smtpauth <command> [args]

Commands:
  add <user>     Add a new SMTP-AUTH entry (prompts for password).
  del <user>     Remove an entry.
  list           List usernames currently authorized for SMTP-AUTH.
  passwd <user>  Change the password for an existing entry.
  test <user>    Authenticate via the bridge end-to-end.

Credentials live in $AUTHFILE.  For Unix users, the entry also carries
uid/gid/home so dovecot's userdb chain serves IMAP/Maildir from this
same file.  Use a password DIFFERENT from the user's Unix login — mail
access and shell-login have different blast radii and should not be
coupled to the same secret.

add/passwd also write ~/$RELAY_AUTH_NAME (mode 0600, owned by the user) with
the password and IMAP/SMTP client-setup instructions; del removes it.
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
    add)              cmd_add    "$@" ;;
    del|rm|remove)    cmd_del    "$@" ;;
    list|ls)          cmd_list   "$@" ;;
    passwd|chpasswd)  cmd_passwd "$@" ;;
    test|verify)      cmd_test   "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd (try: dsmr-smtpauth --help)" ;;
esac
