#!/bin/sh
set -e

SUBMISSION_RUN=/etc/qmail/qmail-submission/run

case "$1" in
    configure)
        # ── Reload dovecot so the new auth-client-smtp listener appears.
        if command -v systemctl >/dev/null 2>&1 \
                && systemctl is-active --quiet dovecot 2>/dev/null; then
            echo "dsmr-checkpassword-dovecot: reloading dovecot..."
            systemctl reload dovecot 2>/dev/null \
                || systemctl restart dovecot 2>/dev/null \
                || true
        fi

        # ── Cycle qmail-submission so its run script re-evaluates which
        #    auth backend to use.  In dsmr-qmail-run >= 1.0-9 the script
        #    picks up /var/qmail/bin/checkpassword-dovecot automatically;
        #    on older versions the operator must edit the run script.
        if command -v svc >/dev/null 2>&1 \
                && [ -d /service/qmail-submission ] \
                && svok /service/qmail-submission 2>/dev/null; then
            echo "dsmr-checkpassword-dovecot: cycling qmail-submission..."
            svc -t /service/qmail-submission || true
        fi

        # ── Warn if the live submission run script still hard-codes vchkpw.
        if [ -f "$SUBMISSION_RUN" ] \
                && grep -q '/home/vpopmail/bin/vchkpw' "$SUBMISSION_RUN" \
                && ! grep -q 'checkpassword-dovecot' "$SUBMISSION_RUN"; then
            cat <<EOF >&2
dsmr-checkpassword-dovecot: NOTE — $SUBMISSION_RUN still references
vchkpw directly.  Either upgrade dsmr-qmail-run to 1.0-9 or later (which
auto-detects /var/qmail/bin/checkpassword-dovecot), or edit the run
script by hand to invoke the bridge in vchkpw's place, then run:

    svc -t /service/qmail-submission
EOF
        fi

        # ── First-install operator next-steps.
        if [ -z "$2" ]; then
            cat <<'EOF'

==============================================================================
dsmr-checkpassword-dovecot installed.

Next steps to enable system-user SMTP-AUTH:

  1. Add allowed system users with dsmr-smtpauth(8):

       sudo dsmr-smtpauth add <user>      # prompts for password
       sudo dsmr-smtpauth list            # show authorized users
       sudo dsmr-smtpauth test <user>     # verify end-to-end

     IMPORTANT: use a password DIFFERENT from the user's Unix login.
     The blast radius of an SMTP relay credential differs from a shell
     account credential; do not reuse.

  2. Test from a remote host:

       swaks --to ext@example.com --from <user>@<your-domain> \
             --server <host> --port 587 --tls \
             --auth LOGIN --auth-user <user>@<your-domain> \
             --auth-password '...'

See /usr/share/doc/dsmr-checkpassword-dovecot/README.md for full details.
==============================================================================
EOF
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
