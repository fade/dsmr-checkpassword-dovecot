#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # On removal the bridge binary will be deleted by dpkg.  We do not
        # touch the live qmail-submission run script here — postrm handles
        # the post-removal refresh once the bridge is actually gone.
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
