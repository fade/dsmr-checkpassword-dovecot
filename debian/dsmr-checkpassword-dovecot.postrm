#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Bridge binary is now gone.  If qmail-submission's run script is
        # the auto-detecting variant from dsmr-qmail-run >= 1.0-9, it will
        # fall back to vchkpw on the next start; cycle the service so that
        # transition happens immediately rather than at the next reboot.
        if command -v svc >/dev/null 2>&1 \
                && [ -d /service/qmail-submission ] \
                && svok /service/qmail-submission 2>/dev/null; then
            svc -t /service/qmail-submission || true
        fi

        # Reload dovecot so the auth-client-smtp listener disappears.
        # dpkg has already removed the conffile (purge) or marked it
        # obsolete (remove).
        if command -v systemctl >/dev/null 2>&1 \
                && systemctl is-active --quiet dovecot 2>/dev/null; then
            systemctl reload dovecot 2>/dev/null \
                || systemctl restart dovecot 2>/dev/null \
                || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
